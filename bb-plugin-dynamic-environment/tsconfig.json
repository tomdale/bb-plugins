{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "app.tsx",
    "src/**/*.ts",
    "*.test.ts",
    "*.test.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "lib/**/*.ts"
  ]
}
