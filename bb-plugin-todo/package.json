{
  "name": "bb-plugin-todo",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.6.5"
  },
  "bb": {
    "name": "Todo",
    "description": "Show the agent's per-thread todo plan in the composer.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.5",
    "@pierre/diffs": "^1.2.9",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "node --test model.test.ts agent.test.ts card.test.ts server.test.ts && vitest run app.test.tsx layout.test.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "files": [
    "README.md",
    "server.ts",
    "model.ts",
    "agent.ts",
    "card.ts",
    "layout.ts",
    "use-todos.ts",
    "use-side-placement.ts",
    "app.tsx",
    "composer-card.tsx",
    "progress-ring.tsx",
    "app.css",
    "tsconfig.json",
    "dist"
  ]
}
