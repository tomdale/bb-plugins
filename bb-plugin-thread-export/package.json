{
  "name": "bb-plugin-thread-export",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.99"
  },
  "bb": {
    "name": "Thread Export",
    "description": "Save a thread as one standalone HTML file that looks like bb's own chat, for someone who does not have bb.",
    "branding": {
      "icon": "Download"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.99",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build"
  },
  "files": [
    "README.md",
    "app.tsx",
    "app.css",
    "server.ts",
    "components",
    "lib",
    "tsconfig.json",
    "dist"
  ]
}
